# Atlas web app — environment variables.
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Both are safe to expose to the browser:
# the URL is public, and the publishable key is the anon-equivalent key (access
# is enforced by Row-Level Security, not by keeping this secret).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("sb_publishable_...") key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Canonical site origin used to build OAuth redirect URLs on hosts
# that serve multiple hostnames (e.g. Netlify deploy permalinks). Leave unset
# for local dev (falls back to the request origin). See docs/auth.md.
# NEXT_PUBLIC_SITE_URL=https://atlas-guesser.netlify.app
